# Copie este arquivo para ".env.local" e preencha com os dados do seu projeto Supabase.
# (No Supabase: Project Settings > API)
#
# Sem estas variaveis, o app roda em modo local (localStorage), sem login.
# Com elas, o app usa o banco do Supabase e exige login.

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Chave de servico (service_role), SO no servidor. Necessaria para o link publico
# de compartilhamento de card (leitura/edicao do teleprompter pelo visitante).
# NUNCA use o prefixo NEXT_PUBLIC nesta. Na Vercel, adicione em Environment Variables.
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-secreta

# (Opcional) Segredo dedicado para assinar o cookie de PIN do compartilhamento.
# Se ausente, o app deriva uma chave por hash da service role (mao unica).
# Defina um valor proprio para poder rotacionar sem trocar a service role.
# SHARE_COOKIE_SECRET=uma-frase-secreta-longa-e-aleatoria
